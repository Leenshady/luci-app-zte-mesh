config zte_mesh 'main'
	# Master switch. The service only starts when this is 1 and the Wi-Fi
	# profile below is complete.
	option enabled '0'
	# standard     = IEEE 1905 / Multi-AP only (no ZTE vendor TLVs)  [tested]
	# zte          = ZTE enhanced interworking                       [experimental]
	# zte_compat   = ZTE mode that also serves older ZTE routers     [experimental]
	option mode 'standard'
	# LAN bridge that carries the mesh control traffic (wired backhaul only).
	option bridge 'br-lan'
	# Wi-Fi profile pushed to the child routers. radio 0 = 2.4 GHz, radio 1 = 5 GHz.
	option wifi_24g_enabled '1'
	option wifi_24g_ssid ''
	option wifi_24g_key ''
	option wifi_5g_enabled '1'
	# 1 = the 5 GHz band uses the 2.4 GHz name and password (the factory baseline); wifi_5g_ssid / wifi_5g_key are then
	# ignored. With 0, an empty wifi_5g_ssid becomes "<2.4 GHz name><wifi_5g_suffix>" (default -5G) and an empty
	# wifi_5g_key is the 2.4 GHz key: the 5 GHz network is renamed on the child routers.
	option wifi_dual_band_sync '1'
	option wifi_5g_ssid ''
	option wifi_5g_key ''
	# Optional, unset = the controller keeps its fixed defaults (see /usr/share/doc or the LuCI page for the meaning):
	#   wifi_5g_suffix, wifi_{24g,5g}_hidden, wifi_{24g,5g}_security (none|psk2|psk-mixed|sae|sae-mixed),
	#   wifi_{24g,5g}_beacon_interval, wifi_{24g,5g}_channel, wifi_{24g,5g}_tx_power, wifi_{24g,5g}_acl_policy,
	#   mesh_v2, mesh_role (master|auto), mlo_enable, band_steer, band_steer_rssi_{24g,5g}, roam_rssi_{24g,5g}, roam_force
	#
	# Extra SSIDs of the child routers (slots of one band must be 1, 2, 3 without a gap):
	#   config zte_mesh_bss
	#   	option band '24g'          # 24g | 5g
	#   	option slot '1'            # 1 guest, 2 spare, 3 hidden backhaul
	#   	option enabled '0'
	#   	option ssid 'guest'
	#   	option key 'at-least-8-chars'
	# MAC filter (up to 16 rules):
	#   config zte_mesh_acl
	#   	option mac 'aa:bb:cc:dd:ee:ff'
