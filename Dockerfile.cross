# Native x86_64 builder: ARM32 glibc cross compiler for the vendor-facing code and
# an AArch64 cross compiler for the router-side static tools. Use with
#   make ROUTERCC=aarch64-linux-gnu-gcc
FROM debian:bookworm-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    gcc gcc-arm-linux-gnueabi binutils-arm-linux-gnueabi libc6-dev libc6-dev-armel-cross \
    gcc-aarch64-linux-gnu libc6-dev-arm64-cross make python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
